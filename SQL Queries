/* ============================================================
   INDIAN E-COMMERCE SALES ANALYSIS - SQL PROJECT
   25 Business Questions (Easy -> Medium -> Hard)
   Tables: customers, products, sales
   ============================================================ */


/* ============================================================
   EASY (Q1 - Q9)
   ============================================================ */

/* Q1: How many total customers, products, and orders are there in the database? */
SELECT 
    (SELECT COUNT(*) FROM customers) AS total_customers,
    (SELECT COUNT(*) FROM products) AS total_products,
    (SELECT COUNT(*) FROM sales) AS total_orders;


/* Q2: What is the total number of orders placed each year, and how many unique customers placed orders each year? */
SELECT 
    YEAR(Order_Date) AS order_year,
    COUNT(Order_ID) AS total_orders,
    COUNT(DISTINCT Customer_ID) AS unique_customers
FROM sales
GROUP BY order_year
ORDER BY order_year;


/* Q3: What is the total revenue generated from all delivered orders? */
SELECT SUM(Total_Amount) AS total_revenue_delivered
FROM sales
WHERE Order_Status = 'Delivered';


/* Q4: Which are the top 5 product categories by number of products listed? */
SELECT Category, COUNT(*) AS num_products
FROM products
GROUP BY Category
ORDER BY num_products DESC
LIMIT 5;


/* Q5: What is the average, minimum, and maximum Selling_Price of products? */
SELECT 
    ROUND(AVG(Selling_Price), 2) AS avg_price,
    MIN(Selling_Price) AS min_price,
    MAX(Selling_Price) AS max_price
FROM products;


/* Q6: How many customers belong to each Customer_Tier? */
SELECT Customer_Tier, COUNT(*) AS num_customers
FROM customers
GROUP BY Customer_Tier
ORDER BY num_customers DESC;


/* Q7: What are the top 5 states with the highest number of registered customers? */
SELECT State, COUNT(*) AS num_customers
FROM customers
GROUP BY State
ORDER BY num_customers DESC
LIMIT 5;


/* Q8: What are the different Payment_Mode values, and how many orders used each? */
SELECT Payment_Mode, COUNT(*) AS total_orders
FROM sales
GROUP BY Payment_Mode
ORDER BY total_orders DESC;


/* Q9: How many products have zero stock remaining (Stock_Quantity = 0)? */
SELECT COUNT(*) AS out_of_stock_products
FROM products
WHERE Stock_Quantity = 0;



/* ============================================================
   MEDIUM (Q10 - Q18)
   ============================================================ */

/* Q10: What is the monthly revenue trend from June 2024 to June 2026? */
SELECT 
    DATE_FORMAT(Order_Date, '%Y-%m') AS month,
    COUNT(DISTINCT Order_ID) AS total_orders,
    SUM(Total_Amount) AS revenue
FROM sales
WHERE Order_Status = 'Delivered'
GROUP BY month
ORDER BY month;


/* Q11: Who are the top 10 customers by total amount spent (join customers + sales)? */
SELECT 
    c.Customer_ID, 
    c.Customer_Name, 
    c.Customer_Tier,
    COUNT(s.Order_ID) AS total_orders,
    SUM(s.Total_Amount) AS total_spent
FROM customers c
JOIN sales s ON c.Customer_ID = s.Customer_ID
GROUP BY c.Customer_ID, c.Customer_Name, c.Customer_Tier
ORDER BY total_spent DESC
LIMIT 10;


/* Q12: Which 10 products generated the highest revenue? */
SELECT 
    p.Product_Name, 
    p.Category, 
    p.Brand,
    SUM(s.Quantity) AS units_sold,
    SUM(s.Total_Amount) AS revenue
FROM sales s
JOIN products p ON s.Product_ID = p.Product_ID
GROUP BY p.Product_Name, p.Category, p.Brand
ORDER BY revenue DESC
LIMIT 10;


/* Q13: What is the average delivery time (in days) per state? */
SELECT 
    State, 
    ROUND(AVG(DATEDIFF(Delivery_Date, Order_Date)), 1) AS avg_delivery_days
FROM sales
WHERE Order_Status = 'Delivered'
GROUP BY State
ORDER BY avg_delivery_days DESC;


/* Q14: What percentage of orders used a coupon code, and how does average order value compare with vs without a coupon? */
SELECT 
    CASE WHEN Coupon_Code IS NULL OR Coupon_Code = '' THEN 'No Coupon' ELSE 'With Coupon' END AS coupon_used,
    COUNT(*) AS total_orders,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pct_of_orders,
    ROUND(AVG(Total_Amount), 2) AS avg_order_value
FROM sales
GROUP BY coupon_used;


/* Q15: Which payment mode has the highest average order value? */
SELECT 
    Payment_Mode, 
    COUNT(*) AS total_orders,
    ROUND(AVG(Total_Amount), 2) AS avg_order_value
FROM sales
GROUP BY Payment_Mode
ORDER BY avg_order_value DESC;


/* Q16: What is the average customer rating per product category? */
SELECT 
    p.Category, 
    ROUND(AVG(s.Rating), 2) AS avg_customer_rating,
    COUNT(s.Rating) AS num_ratings
FROM sales s
JOIN products p ON s.Product_ID = p.Product_ID
WHERE s.Rating IS NOT NULL
GROUP BY p.Category
ORDER BY avg_customer_rating DESC;


/* Q17: Which cities have the highest number of cancelled or returned orders? */
SELECT 
    City, 
    Order_Status,
    COUNT(*) AS total_orders
FROM sales
WHERE Order_Status IN ('Cancelled', 'Returned')
GROUP BY City, Order_Status
ORDER BY total_orders DESC
LIMIT 10;


/* Q18: What is the average discount percentage offered per brand, and how does it relate to units sold? */
SELECT 
    p.Brand,
    ROUND(AVG(p.Discount_Percent), 2) AS avg_discount_pct,
    SUM(s.Quantity) AS total_units_sold
FROM products p
JOIN sales s ON p.Product_ID = s.Product_ID
GROUP BY p.Brand
ORDER BY avg_discount_pct DESC;



/* ============================================================
   HARD (Q19 - Q25)
   ============================================================ */

/* Q19: Identify customers who haven't placed an order in the last 90 days
   (from the most recent order date in the dataset) - a churn risk list. */
SELECT 
    c.Customer_ID, 
    c.Customer_Name, 
    MAX(s.Order_Date) AS last_order_date,
    DATEDIFF((SELECT MAX(Order_Date) FROM sales), MAX(s.Order_Date)) AS days_inactive
FROM customers c
JOIN sales s ON c.Customer_ID = s.Customer_ID
GROUP BY c.Customer_ID, c.Customer_Name
HAVING days_inactive > 90
ORDER BY days_inactive DESC;


/* Q20: Using RFM logic, segment customers into quartiles based on total spend (NTILE). */
SELECT 
    Customer_ID, 
    total_spent,
    NTILE(4) OVER (ORDER BY total_spent DESC) AS spend_quartile
FROM (
    SELECT Customer_ID, SUM(Total_Amount) AS total_spent
    FROM sales
    GROUP BY Customer_ID
) t
ORDER BY total_spent DESC;


/* Q21: Find the month-over-month revenue growth rate (%) using a window function (LAG). */
WITH monthly_revenue AS (
    SELECT 
        DATE_FORMAT(Order_Date, '%Y-%m') AS month,
        SUM(Total_Amount) AS revenue
    FROM sales
    WHERE Order_Status = 'Delivered'
    GROUP BY month
)
SELECT 
    month,
    revenue,
    LAG(revenue) OVER (ORDER BY month) AS prev_month_revenue,
    ROUND(
        (revenue - LAG(revenue) OVER (ORDER BY month)) * 100.0 
        / LAG(revenue) OVER (ORDER BY month), 2
    ) AS mom_growth_pct
FROM monthly_revenue
ORDER BY month;


/* Q22: Identify products that are "at risk" of stockout -
   high sales velocity but low remaining Stock_Quantity. */
SELECT 
    p.Product_Name, 
    p.Category,
    p.Stock_Quantity, 
    SUM(s.Quantity) AS total_units_sold
FROM products p
JOIN sales s ON p.Product_ID = s.Product_ID
GROUP BY p.Product_Name, p.Category, p.Stock_Quantity
HAVING p.Stock_Quantity < 20
ORDER BY total_units_sold DESC;


/* Q23: Find the top-selling product in each category (highest revenue per category)
   using a window function (RANK). */
WITH product_revenue AS (
    SELECT 
        p.Category, 
        p.Product_Name,
        SUM(s.Total_Amount) AS revenue,
        RANK() OVER (PARTITION BY p.Category ORDER BY SUM(s.Total_Amount) DESC) AS rnk
    FROM sales s
    JOIN products p ON s.Product_ID = p.Product_ID
    GROUP BY p.Category, p.Product_Name
)
SELECT Category, Product_Name, revenue
FROM product_revenue
WHERE rnk = 1
ORDER BY revenue DESC;


/* Q24: Calculate each customer's repeat purchase rate -
   the % of customers who ordered more than once, broken down by Customer_Tier. */
WITH customer_orders AS (
    SELECT 
        c.Customer_ID, 
        c.Customer_Tier,
        COUNT(s.Order_ID) AS order_count
    FROM customers c
    JOIN sales s ON c.Customer_ID = s.Customer_ID
    GROUP BY c.Customer_ID, c.Customer_Tier
)
SELECT 
    Customer_Tier,
    COUNT(*) AS total_customers,
    SUM(CASE WHEN order_count > 1 THEN 1 ELSE 0 END) AS repeat_customers,
    ROUND(SUM(CASE WHEN order_count > 1 THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS repeat_purchase_rate_pct
FROM customer_orders
GROUP BY Customer_Tier
ORDER BY repeat_purchase_rate_pct DESC;


/* Q25: Using a CTE, calculate each customer's average days between orders,
   and identify the top 10 most "frequent" customers
   (shortest average gap between orders, with at least 3 orders). */
WITH order_gaps AS (
    SELECT 
        Customer_ID,
        Order_Date,
        DATEDIFF(
            Order_Date, 
            LAG(Order_Date) OVER (PARTITION BY Customer_ID ORDER BY Order_Date)
        ) AS days_since_last_order
    FROM sales
)
SELECT 
    Customer_ID,
    COUNT(*) AS total_orders,
    ROUND(AVG(days_since_last_order), 1) AS avg_days_between_orders
FROM order_gaps
WHERE days_since_last_order IS NOT NULL
GROUP BY Customer_ID
HAVING COUNT(*) >= 2 -- at least 3 orders total (2+ gaps)
ORDER BY avg_days_between_orders ASC
LIMIT 10;
